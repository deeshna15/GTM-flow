APP_ENV=development
APP_NAME=GTMFlow
APP_PORT=8000
SECRET_KEY=dev_secret_key_minimum_32_characters_long_12345
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://gtmflow:gtmflow_secret_password@localhost:5432/gtmflow

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# JWT
JWT_SECRET_KEY=dev_jwt_secret_key_minimum_32_characters_12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
