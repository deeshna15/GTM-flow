# ==========================================
# GTMFlow - Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=GTMFlow
APP_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_min32chars
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=gtmflow
POSTGRES_PASSWORD=gtmflow_secret_password
POSTGRES_DB=gtmflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gtmflow:gtmflow_secret_password@localhost:5432/gtmflow

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT_SECONDS=30

# JWT Authentication
JWT_SECRET_KEY=change_this_jwt_secret_key_to_something_secure_min32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json

# Next.js Public Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
